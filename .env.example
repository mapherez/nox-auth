# Required. Use your Auth HTTPS origin; apps may keep their private HTTP URLs.
NOX_AUTH_PUBLIC_URL=https://auth.example.com
NOX_AUTH_GOOGLE_CLIENT_ID=
NOX_AUTH_GOOGLE_CLIENT_SECRET=
NOX_AUTH_ALLOWED_EMAILS=you@example.com

# Optional deployment overrides; the service generates/persists its own keys.
# NOX_AUTH_PORT=5712
# NOX_AUTH_IMAGE_TAG=latest
# NOX_AUTH_DATA_VOLUME_NAME=nox-auth-data
# NOX_SUITE_LOCAL_VOLUME_NAME=nox-suite-local
# NOX_AUTH_ADMIN_VOLUME_NAME=nox-auth-admin
