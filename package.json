{
  "name": "nox-auth",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "check": "sh scripts/check.sh",
    "release": "node scripts/release.mjs",
    "test:ci-policy": "node --test scripts/ci-policy.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-hooks.mjs')) await import('./scripts/install-hooks.mjs');\"",
    "precommit": "node scripts/git-hooks.mjs commit",
    "format": "node scripts/git-hooks.mjs format",
    "prepush": "npm run check"
  }
}
